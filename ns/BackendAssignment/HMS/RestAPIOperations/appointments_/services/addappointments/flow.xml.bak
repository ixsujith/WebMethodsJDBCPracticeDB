<MAPCOPY FROM="/doctorScheduleOutput;2;0/results;2;0/AVAILABLE_DATE;1;0" TO="/doctorAvailableDate;1;0">
</MAPCOPY>

<MAPCOPY FROM="/doctorScheduleOutput;2;0/results;2;0/START_TIME;1;0" TO="/doctorScheduleStartTime;1;0">
</MAPCOPY>

<MAPCOPY FROM="/doctorScheduleOutput;2;0/results;2;0/END_TIME;1;0" TO="/doctorScheduleEndTime;1;0">
</MAPCOPY>

<MAPCOPY FROM="/doctorScheduleOutput;2;0/results;2;0/AVAILABILITY_STATUS;1;0" TO="/doctorAvailabilityStatus;1;0">
</MAPCOPY>
</MAP>

<BRANCH TIMEOUT="" SWITCH="/doctorAvailabilityStatus">
  <COMMENT></COMMENT>

  <!-- nodes -->

<SEQUENCE NAME="Available" TIMEOUT="" EXIT-ON="FAILURE">
  <COMMENT></COMMENT>

  <!-- nodes -->

<BRANCH TIMEOUT="" LABELEXPRESSIONS="true">
  <COMMENT></COMMENT>

  <!-- nodes -->

<SEQUENCE NAME="APPOINTMENT_DATE_INPUT == doctorAvailableDate" TIMEOUT="" EXIT-ON="FAILURE">
  <COMMENT></COMMENT>

  <!-- nodes -->

<BRANCH TIMEOUT="" LABELEXPRESSIONS="true">
  <COMMENT></COMMENT>

  <!-- nodes -->

<SEQUENCE NAME="doctorScheduleStartTime &lt;= APPOINTMENT_TIME_INPUT &amp;&amp; APPOINTMENT_TIME_INPUT &lt; doctorScheduleEndTime" TIMEOUT="" EXIT-ON="FAILURE">
  <COMMENT></COMMENT>

  <!-- nodes -->

<MAP TIMEOUT="" MODE="STANDALONE">
  <COMMENT></COMMENT>
