  <COMMENT></COMMENT>

  <!-- nodes -->

<SEQUENCE NAME="prevStartTime &lt;= prevAppointmentTime &amp;&amp; prevAppointmentTime &lt;= prevEndTime" TIMEOUT="" EXIT-ON="FAILURE">
  <COMMENT></COMMENT>

